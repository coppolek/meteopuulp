rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for app settings and banners so guests can view announcements and ads
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /custom_webcams/{camId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Allow authenticated users to manage their data and admin operations
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

