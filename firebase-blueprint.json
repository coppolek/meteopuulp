{
  "entities": {
    "favorites": {
      "title": "Favorite Webcams",
      "description": "User bookmarked webcams",
      "type": "object",
      "properties": {
        "webcamId": { "type": "number" },
        "title": { "type": "string" },
        "cityName": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["webcamId", "userId"]
    },
    "webcam_likes": {
      "title": "Webcam Likes Counter",
      "description": "Aggregated likes counter per webcam",
      "type": "object",
      "properties": {
        "webcamId": { "type": "number" },
        "count": { "type": "number" }
      },
      "required": ["webcamId", "count"]
    },
    "saved_cities": {
      "title": "Saved Cities",
      "description": "User custom cities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "country": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "lat", "lon", "userId"]
    },
    "comments": {
      "title": "Webcam Comments",
      "description": "Community comments on webcams",
      "type": "object",
      "properties": {
        "webcamId": { "type": "number" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["webcamId", "text", "userId"]
    },
    "app_settings": {
      "title": "Application Settings",
      "description": "Global settings and API keys configuration",
      "type": "object",
      "properties": {
        "announcementText": { "type": "string" },
        "announcementActive": { "type": "boolean" },
        "requireLoginForCams": { "type": "boolean" },
        "windyApiKey": { "type": "string" },
        "openWeatherApiKey": { "type": "string" },
        "geminiApiKey": { "type": "string" }
      }
    },
    "banners": {
      "title": "Promotional Banners",
      "description": "Advertising and info banners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "linkUrl": { "type": "string" },
        "position": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "position"]
    },
    "user_profiles": {
      "title": "User Profiles and Subscriptions",
      "description": "User roles and membership plans",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "plan": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    }
  }
}
